{
  "name": "gpuix-mobile",
  "version": "1.0.0",
  "description": "Unified native mobile host (Android & iOS) and CLI for React on GPUIX using GPUI, wgpu and standalone Hermes without WebView.",
  "type": "module",
  "license": "MIT",
  "keywords": [
    "gpuix",
    "gpui",
    "mobile",
    "android",
    "ios",
    "react",
    "hermes",
    "wgpu",
    "native",
    "ota",
    "merkle"
  ],
  "files": [
    "README.md",
    "README.zh-CN.md",
    "CONTRIBUTING.md",
    "SECURITY.md",
    "LICENSE",
    "docs",
    "templates",
    "scripts/*.ts",
    "runtime",
    "native/hermes",
    "native/vendor/gpui-mobile/src",
    "native/vendor/gpui-mobile/Cargo.toml",
    "native/vendor/gpui-mobile/Cargo.lock",
    "native/vendor/gpui-mobile/LICENSE-APACHE",
    "native/vendor/gpui-mobile/LICENSE-AGPL",
    "native/vendor/gpui-mobile/LICENSE-GPL",
    "native/vendor/gpuix-native/src",
    "native/vendor/gpuix-native/gpui-terminal",
    "native/vendor/gpuix-native/Cargo.toml",
    "native/vendor/gpuix-native/Cargo.lock",
    "native/vendor/gpuix-native/build.rs",
    "native/vendor/gpuix-native/LICENSE",
    "android/.cargo",
    "android/README.md",
    "android/app/build.gradle.kts",
    "android/app/proguard-rules.pro",
    "android/app/src/debug",
    "android/app/src/main/AndroidManifest.xml",
    "android/app/src/main/java",
    "android/app/src/main/res",
    "android/build.gradle.kts",
    "android/gradle.properties",
    "android/gradle",
    "android/gradlew",
    "android/rust/Cargo.lock",
    "android/rust/Cargo.toml",
    "android/rust/rust-toolchain.toml",
    "android/rust/build.rs",
    "android/rust/src",
    "android/scripts",
    "android/settings.gradle.kts",
    "ios/app",
    "ios/rust/Cargo.toml",
    "ios/rust/rust-toolchain.toml",
    "ios/rust/src",
    "ios/scripts"
  ],
  "exports": {
    "./native-sdk": {
      "types": "./runtime/types.ts"
    },
    "./runtime": {
      "types": "./runtime/types.ts",
      "import": "./runtime/index.ts"
    }
  },
  "bin": {
    "gpuix": "./scripts/gpuix.ts",
    "gpuix-mobile": "./scripts/gpuix.ts",
    "gpuix-android": "./scripts/gpuix.ts"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "bun test",
    "help": "bun scripts/gpuix.ts help"
  },
  "devDependencies": {
    "@types/bun": "^1.2.0",
    "typescript": "^5.3.0"
  }
}
